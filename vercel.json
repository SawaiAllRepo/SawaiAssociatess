
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/staff",
      "destination": "https://sawai-associates-chatbot.onrender.com/staff/"
    },
    {
      "source": "/staff/:path*",
      "destination": "https://sawai-associates-chatbot.onrender.com/staff/:path*"
    },
    {
      "source": "/admin",
      "destination": "https://sawai-associates-chatbot.onrender.com/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://sawai-associates-chatbot.onrender.com/admin/:path*"
    },
    {
      "source": "/chat",
      "destination": "https://sawai-associates-chatbot.onrender.com/chat"
    },
    {
      "source": "/analytics",
      "destination": "https://sawai-associates-chatbot.onrender.com/analytics"
    },
    {
      "source": "/analytics/:path*",
      "destination": "https://sawai-associates-chatbot.onrender.com/analytics/:path*"
    },
    {
      "source": "/health",
      "destination": "https://sawai-associates-chatbot.onrender.com/health"
    },
    {
      "source": "/((?!chatbot/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/staff(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
